# Ejemplo de .env — copia este archivo a .env y rellena con valores reales.
DB_PASSWORD=changeme_db_password

# Obligatoria y de al menos 32 caracteres: el backend se niega a arrancar sin
# ella. Genérala con:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# ── OpenRouter — pasarela única para texto e imágenes ──────────────────────
# Obtener en https://openrouter.ai/keys (la key parte con "sk-or-v1-").
# Las imágenes requieren créditos comprados; el texto puede funcionar sin ellos
# según el modelo. Recomendado: límite de gasto en la key y Model Training
# desactivado en Settings → Privacy antes de usarla con material escolar.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# ── Proveedores directos, opcionales ───────────────────────────────────────
# Solo se usan si el usuario configura su propia clave. Ninguno es el default.
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

ALLOW_REGISTRATION=false
